# Copy to .env.local for `next dev`, or set these in Vercel / Netlify.
# Never commit real secrets.

# --- Database ---
# Production (Vercel and Netlify): a Turso / libSQL database.
# TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
# TURSO_AUTH_TOKEN=
# Local development: leave both unset to use data/local.db.
# ALLOW_LOCAL_DB=true

# --- Secret pepper ---
# Required in production. At least 32 random characters.
# Changing it later invalidates existing tracking keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_PEPPER=replace-with-a-random-string-at-least-32-characters

# --- Bootstrap the Vice Chancellor account ---
# Applied only when that email does not exist yet.
# Set BOOTSTRAP_RESET_PASSWORDS=true for one boot to overwrite passwords, then turn it off.
# Password: at least 12 characters, with uppercase, lowercase, and a number.
BOOTSTRAP_VC_EMAIL=vc@mnsuam.invalid
BOOTSTRAP_VC_NAME=Vice Chancellor
BOOTSTRAP_VC_PASSWORD=ChangeMe_Now_12
# BOOTSTRAP_ADMIN_EMAIL=admin@mnsuam.invalid
# BOOTSTRAP_ADMIN_NAME=System administrator
# BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Now_12
# Optional extra accounts. facultyId and departmentId must match seeded ids
# (for example foc and foc-aids). Use placeholder emails until real ones are confirmed.
# BOOTSTRAP_USERS_JSON=[{"email":"chair.aids@mnsuam.invalid","name":"Prof. Dr. Ayesha Hakim","password":"ChangeMe_Now_12","role":"chairperson","facultyId":"foc","departmentId":"foc-aids"}]
# BOOTSTRAP_RESET_PASSWORDS=false

# Where escalation notices for the Vice Chancellor are sent.
# Defaults to BOOTSTRAP_VC_EMAIL on first boot. Editable later in the portal.
# VC_NOTIFICATION_EMAIL=placeholder+vice-chancellor@mnsuam.invalid

# --- Harassment routing (optional) ---
# Used only on first boot. Edit later under Dashboard → Contacts.
# Addresses containing "placeholder" or ending in .invalid are NOT delivered
# once SMTP or Resend is switched on. They are still recorded in the mail log.
HARASSMENT_FOCAL_NAME=Harassment Focal Person
HARASSMENT_FOCAL_EMAIL=placeholder+harassment-focal@mnsuam.invalid
HARASSMENT_COMMITTEE_EMAIL=placeholder+harassment-committee@mnsuam.invalid

# --- Email ---
# Precedence: SMTP if SMTP_HOST is set, otherwise Resend if RESEND_API_KEY is set,
# otherwise safe log-only mode (nothing is delivered; the message is printed and stored).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=MNSUAM Complaints Portal <complaints@mnsuam.edu.pk>
# RESEND_API_KEY=
# RESEND_FROM=MNSUAM Complaints Portal <complaints@mnsuam.edu.pk>

# --- Public URL (used in email links and the embed snippet) ---
# NEXT_PUBLIC_APP_URL=https://mnsuam-complaints.netlify.app

# --- University website (header and footer link) ---
# Defaults to the new university website demo, not the legacy Joomla site.
# NEXT_PUBLIC_UNIVERSITY_SITE_URL=https://mnsuam-website-demo.netlify.app

# --- Optional Cloudflare Turnstile spam check ---
# When TURNSTILE_SECRET_KEY is set, the server requires a valid token.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
